#!/usr/bin/env python3
"""Derive canonical engineering slugs and work IDs using only the stdlib."""

from __future__ import annotations

import argparse
import hashlib
import itertools
import re
import sys
import unicodedata


MAX_SLUG_BYTES = 48
# A work ID is also a branch leaf and a source tree directory name, so it is
# held well below the document slug bound.
MAX_WORK_ID_BYTES = 32
# The leading token of a minted work ID is a conventional-commit type, which
# is what makes `<kind>-<scope>` reversible to the branch `<kind>/<scope>`.
WORK_KINDS = (
    "build",
    "chore",
    "ci",
    "docs",
    "feat",
    "fix",
    "perf",
    "refactor",
    "revert",
    "style",
    "test",
)


class CanonicalNameError(ValueError):
    """An input cannot produce a canonical engineering name."""


def ascii_tokens(value: str) -> list[str]:
    normalized = unicodedata.normalize("NFKD", value)
    ascii_value = normalized.encode("ascii", "ignore").decode("ascii").lower()
    return re.findall(r"[a-z0-9]+", ascii_value)


def bounded_slug(value: str, max_bytes: int = MAX_SLUG_BYTES) -> str:
    tokens = ascii_tokens(value)
    if not tokens:
        return "item"

    slug = "-".join(tokens)
    if len(slug.encode("ascii")) <= max_bytes:
        return slug

    kept: list[str] = []
    used = 0
    for token in tokens:
        added = len(token) + (1 if kept else 0)
        if used + added > max_bytes:
            break
        kept.append(token)
        used += added

    # A single machine-generated token can exceed the bound. There is no
    # smaller token boundary to preserve, so retain its first 48 ASCII bytes.
    return "-".join(kept) if kept else tokens[0][:max_bytes]


def collision_slug(value: str, stable_id: str | None, collisions: set[str]) -> str:
    slug = bounded_slug(value)
    if slug not in collisions:
        return slug
    if not stable_id:
        raise CanonicalNameError(
            "--stable-id is required when the derived slug collides"
        )
    suffix = hashlib.sha256(stable_id.encode("utf-8")).hexdigest()[:8]
    collision_base = bounded_slug(value, MAX_SLUG_BYTES - len(suffix) - 2)
    return f"{collision_base}--{suffix}"


def tracker_work_id(value: str) -> str:
    return bounded_slug(value)


def minted_work_id(kind: str, scope: str, occupied: set[str]) -> str:
    kind_slug = "-".join(ascii_tokens(kind))
    if kind_slug not in WORK_KINDS:
        raise CanonicalNameError(
            "--kind must be a conventional-commit type: " + ", ".join(WORK_KINDS)
        )
    if not ascii_tokens(scope):
        raise CanonicalNameError("--scope must contain at least one ASCII token")

    def candidate(suffix: str) -> str:
        budget = MAX_WORK_ID_BYTES - len(kind_slug) - 1 - len(suffix)
        return f"{kind_slug}-{bounded_slug(scope, budget)}{suffix}"

    base = candidate("")
    if base not in occupied:
        return base

    # An identity is never renamed, so a repeated scope takes the next free
    # ordinal rather than displacing the stream that already owns the name.
    for ordinal in itertools.count(2):
        repeated = candidate(f"-{ordinal}")
        if repeated not in occupied:
            return repeated


def parser() -> argparse.ArgumentParser:
    root = argparse.ArgumentParser(
        description="derive canonical engineering slugs and work IDs"
    )
    commands = root.add_subparsers(dest="command", required=True)

    slug = commands.add_parser("slug")
    slug.add_argument("value")
    slug.add_argument("--stable-id")
    slug.add_argument("--collision-with", action="append", default=[])

    tracker = commands.add_parser("tracker-work-id")
    tracker.add_argument("tracker_key")

    minted = commands.add_parser(
        "minted-work-id",
        help="mint a work identity that doubles as its branch and source tree",
        description=(
            "Mint `<kind>-<scope-slug>` (at most %d bytes) as the identity of a "
            "work stream. The same name carries three things: the work ID "
            "(`feat-work-id-naming`), the branch or bookmark that stream is "
            "developed on (`feat/work-id-naming` — the ID with its first `-` as "
            "`/`), and its source tree directory "
            "(`~/.workspaces/<project>/feat-work-id-naming`). Create the branch "
            "from the ID and the workspace resolver selects the stream unaided, "
            "reporting `work_id_source: git_branch`; a branch that does not "
            "derive back to its ID leaves every later resolve on the "
            "ask-the-user path. The date a stream began belongs to its goal.md "
            "and journal, never to the identity." % MAX_WORK_ID_BYTES
        ),
    )
    minted.add_argument(
        "--kind",
        required=True,
        help="conventional-commit type: " + ", ".join(WORK_KINDS),
    )
    minted.add_argument("--scope", required=True, help="what the stream is about")
    minted.add_argument(
        "--collision-with",
        action="append",
        default=[],
        metavar="WORK_ID",
        help=(
            "an already-occupied work ID; pass every ID under works/ and "
            "archive/, and a repeated scope takes the next free ordinal "
            "(chore-lint-2). Repeatable."
        ),
    )
    return root


def main() -> int:
    args = parser().parse_args()
    try:
        if args.command == "slug":
            result = collision_slug(
                args.value, args.stable_id, set(args.collision_with)
            )
        elif args.command == "tracker-work-id":
            result = tracker_work_id(args.tracker_key)
        else:
            result = minted_work_id(
                args.kind, args.scope, set(args.collision_with)
            )
    except CanonicalNameError as error:
        print(f"invalid: {error}", file=sys.stderr)
        return 2
    print(result)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
