#!/usr/bin/env bash
# Request recovery only for owned material work without a current checkpoint.
# state-checkpoint owns pending-state detection and the per-turn repair limit.
set -euo pipefail
root="${PLUGIN_ROOT:-${GROK_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-}}}"
if [ -z "$root" ]; then
  echo "plugin root unset" >&2
  exit 1
fi
exec "$root/scripts/state-checkpoint.ts" stop --prompt "${1:-$root/hooks/STOP.md}"
